{
  // Samo za proveru tipova u VS Code-u (Supabase i Deno ovaj fajl ne koriste).
  // Deno tipovi za editor su u deno-env.d.ts.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Svaka funkcija je zaseban modul (kao u Deno-u), pa se nazivi ne sudaraju.
    "moduleDetection": "force",
    "types": []
  },
  "include": ["**/*.ts"]
}
